{
  "name": "n0n",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bun run apps/cli/src/main.ts",
    "start:code": "bun run apps/cli/src/main.ts",
    "start:skill": "bun run apps/cli/src/main.ts skill",
